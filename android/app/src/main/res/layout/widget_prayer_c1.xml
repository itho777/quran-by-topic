<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_prayer_c1_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_hijri_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="5"
        android:orientation="horizontal">

        <!-- Left panel: Next prayer summary -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp">

            <LinearLayout
                android:id="@+id/card_next_prayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_card_inactive"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tv_next_prayer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_next_prayer_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/widget_gold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/widget_gold"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ring_next_prayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_card_active_gold"
                android:visibility="visible"
                android:scaleType="fitXY" />
        </FrameLayout>

        <!-- Right panel: prayer rows -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Row P1 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">

                <LinearLayout
                    android:id="@+id/row_p1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/dot_p1"
                        android:layout_width="12dp"
                        android:layout_height="wrap_content"
                        android:text="•"
                        android:textColor="@color/widget_gold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_p1_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_p1_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ring_p1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_row_active_emerald"
                    android:visibility="gone"
                    android:scaleType="fitXY" />
            </FrameLayout>

            <!-- Row P2 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">

                <LinearLayout
                    android:id="@+id/row_p2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/dot_p2"
                        android:layout_width="12dp"
                        android:layout_height="wrap_content"
                        android:text="•"
                        android:textColor="@color/widget_gold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_p2_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_p2_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ring_p2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_row_active_emerald"
                    android:visibility="gone"
                    android:scaleType="fitXY" />
            </FrameLayout>

            <!-- Row P3 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">

                <LinearLayout
                    android:id="@+id/row_p3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/dot_p3"
                        android:layout_width="12dp"
                        android:layout_height="wrap_content"
                        android:text="•"
                        android:textColor="@color/widget_gold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_p3_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_p3_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ring_p3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_row_active_emerald"
                    android:visibility="gone"
                    android:scaleType="fitXY" />
            </FrameLayout>

            <!-- Row P4 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">

                <LinearLayout
                    android:id="@+id/row_p4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/dot_p4"
                        android:layout_width="12dp"
                        android:layout_height="wrap_content"
                        android:text="•"
                        android:textColor="@color/widget_gold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_p4_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_p4_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ring_p4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_row_active_emerald"
                    android:visibility="gone"
                    android:scaleType="fitXY" />
            </FrameLayout>

            <!-- Row P5 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/row_p5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/dot_p5"
                        android:layout_width="12dp"
                        android:layout_height="wrap_content"
                        android:text="•"
                        android:textColor="@color/widget_gold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_p5_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_p5_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ring_p5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_card_active_emerald"
                    android:visibility="gone"
                    android:scaleType="fitXY" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
