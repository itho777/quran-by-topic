<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_prayer_c4_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Waktu Sholat"
            android:textColor="@color/widget_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_countdown_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_amber"
            android:textColor="@color/widget_bg"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Card P1 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">

            <LinearLayout
                android:id="@+id/card_frost_p1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_card_inactive"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_fp1_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_fp1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ring_fp1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_card_active_gold"
                android:visibility="gone"
                android:scaleType="fitXY" />
        </FrameLayout>

        <!-- Card P2 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">

            <LinearLayout
                android:id="@+id/card_frost_p2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_card_inactive"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_fp2_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_fp2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ring_fp2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_card_active_gold"
                android:visibility="gone"
                android:scaleType="fitXY" />
        </FrameLayout>

        <!-- Card P3 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">

            <LinearLayout
                android:id="@+id/card_frost_p3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_card_inactive"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_fp3_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_fp3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ring_fp3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_card_active_gold"
                android:visibility="gone"
                android:scaleType="fitXY" />
        </FrameLayout>

        <!-- Card P4 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">

            <LinearLayout
                android:id="@+id/card_frost_p4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_card_inactive"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_fp4_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_fp4_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ring_fp4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_card_active_gold"
                android:visibility="gone"
                android:scaleType="fitXY" />
        </FrameLayout>

        <!-- Card P5 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/card_frost_p5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_card_inactive"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_fp5_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_fp5_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ring_fp5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_card_active_gold"
                android:visibility="gone"
                android:scaleType="fitXY" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_footer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
